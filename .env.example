# --- Required ---
# SQLite locally. On Vercel, use a Postgres URL (Neon via the Vercel Marketplace); the build switches the provider.
DATABASE_URL="file:./dev.db"
# Any long random string: `openssl rand -base64 32`
AUTH_SECRET="change-me-to-a-long-random-string"
# Public base URL used in emails, QR codes, scenario links and embeds
APP_URL="http://localhost:3000"
# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET="change-me"

# --- Optional: every integration falls back to a working mock when empty ---
# Email (magic links, investor PDFs, alerts, digests): https://resend.com/api-keys  (free: 3,000/month)
RESEND_API_KEY=""
EMAIL_FROM="DSCR Toolkit <onboarding@resend.dev>"
# Claude (notes extraction, outreach and follow-up drafts): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
# Rent estimates + property tax records: https://app.rentcast.io/app/api  (free: 50 calls/month)
RENTCAST_API_KEY=""
# Bot protection on public forms: https://dash.cloudflare.com/?to=/:account/turnstile  (free)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Demo / development ---
# One-click demo sign-in on /login. Always on in development; set to "true" for a hosted demo only.
DEMO_LOGIN=""
# Audio transcription is off in v1 (paste-only). Reserved for a future provider.
TRANSCRIPTION_ENABLED=""
TRANSCRIBE_API_KEY=""

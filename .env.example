# --- Required ---
# SQLite locally. On Vercel, use a Postgres URL (Neon via Vercel Marketplace).
DATABASE_URL="file:./dev.db"
# Any long random string: `openssl rand -base64 32`
AUTH_SECRET="change-me-to-a-long-random-string"
# Public base URL used in emails, QR codes and embeds
APP_URL="http://localhost:3000"

# --- Optional (mock mode when empty) ---
# Email: https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="DSCR Toolkit <onboarding@resend.dev>"
# Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Rent estimates: https://app.rentcast.io/app/api
RENTCAST_API_KEY=""
# Any Whisper-compatible API (OpenAI, Groq, ...)
TRANSCRIBE_API_KEY=""
TRANSCRIBE_BASE_URL="https://api.openai.com/v1"
TRANSCRIBE_MODEL="whisper-1"
# Vercel Blob (only needed on Vercel for call recordings > 4.5 MB)
BLOB_READ_WRITE_TOKEN=""
# Protects /api/cron/* (Vercel sends it automatically as a Bearer token)
CRON_SECRET="change-me"
